# SECRETS ONLY. Copy to .env, which is gitignored and must stay that way.
#
# Parameters — thresholds, model names, pool sizes — belong in config.yml,
# which is committed. If you are about to add a tuning knob here, it goes there
# instead.

# Local Postgres over the unix socket as your own user.
# In production this is a Cloud SQL connection string from Secret Manager.
DATABASE_URL=postgresql:///claimloop

GROQ_API_KEY=

# Optional: selects a profile from config.yml. Unset means `default` only.
# APP_ENV=production
