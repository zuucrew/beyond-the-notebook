# SECRETS AND CONNECTION IDENTITY. Copy to .env, which is gitignored.
#
# Parameters -- thresholds, model names, pool sizes -- belong in config.yml,
# which is committed. The split: anything Docker or the cloud needs before
# Python starts, or anything that would be embarrassing in a public repo, goes
# here. Everything the application tunes goes in config.yml.

# Two ways to reach Cloud SQL. Pick one.
#
# A -- authorised networks: add your IP in the Console, then point straight at
#      the instance's public IP. No proxy, no CLI, no keys.
# DATABASE_URL=postgresql://claim:YOUR_PASSWORD@34.87.x.x:5432/claimloop
#
# B -- Auth Proxy: run `gcloud auth application-default login` once, then
#      `docker compose --profile proxy up -d cloudsql-proxy`.
CLOUDSQL_INSTANCE=my-project:us-central1:claim-loop-db
DATABASE_URL=postgresql://claim:YOUR_PASSWORD@cloudsql-proxy:5432/claimloop

GROQ_API_KEY=

# Path to the GCP service account key the proxy uses. Defaults to ./gcp-key.json.
# GCP_CREDENTIALS_FILE=./gcp-key.json

# Optional: selects a profile from config.yml. Unset means `default` only.
# APP_ENV=production
