# Copy to .env and fill in. .env is gitignored and must stay that way.

# Local Postgres over the unix socket as your own macOS user.
DATABASE_URL=postgresql:///claimloop

# Used only once a real extraction model replaces the stub.
GROQ_API_KEY=

# D-007 — the escalation threshold. Change it and watch the auto-approve rate
# move. A number to argue with, not to defend.
CONFIDENCE_THRESHOLD=0.80

# How long a worker or reviewer may hold a claim (seconds).
# Set it to 10 to watch the reaper do its job.
LEASE_SECONDS=900

# Attempts before a claim goes to extraction_failed.
MAX_ATTEMPTS=3

# Connection pool, per process. instances x DB_POOL_MAX must stay under the
# database's max_connections -- roughly 25-50 on the smallest Cloud SQL tiers.
# On serverless, 1 or 2 is normal.
DB_POOL_MIN=1
DB_POOL_MAX=5
